 }
 
 fn insert(&mut self, name: HeaderName) {
 if ! self.num_entries.contains_key(&name) { let idx = 0; self.num_entries.insert(name.clone(), 1); self.entry_order.push((name, idx)); }
 }
 
 fn append(&mut self, name: N) {
 let _ = name.into();
 let idx;
 if self.num_entries.contains_key(&name) { idx = self.num_entries [&name]; *self.num_entries.get_mut(&name).unwrap() += 1; } else { idx = 0; self.num_entries.insert(name.clone(), 1); }
 self.entry_order.push((name, idx));
 }
 
 fn get_in_order(&self) -> impl Iterator<_> {
